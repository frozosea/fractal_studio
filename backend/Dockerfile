FROM debian:bookworm-slim AS build

ARG CUDA_ARCHITECTURES=89

# CUDA is supplied as a read-only BuildKit context generated by
# scripts/stage-cuda-toolkit.sh from the deployment host.
# Keeping it out of the image avoids downloading and retaining the multi-GB
# devel image while still producing native Ada (sm_89) kernels.
RUN printf 'Acquire::http::Timeout "30";\nAcquire::https::Timeout "30";\nAcquire::Retries "3";\n' \
        > /etc/apt/apt.conf.d/99-timeout \
    && sed -i -e 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
              -e 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
        $(ls /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null) \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake libopencv-dev libsqlite3-dev libssl-dev libomp-dev \
        libmpfr-dev libgmp-dev python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY backend /src/backend
RUN --mount=type=bind,from=cuda-toolkit,source=/,target=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    cmake -S backend -B build -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
    && cmake --build build --target fractal_studio_backend -j2

FROM debian:bookworm-slim
RUN printf 'Acquire::http::Timeout "30";\nAcquire::https::Timeout "30";\nAcquire::Retries "3";\n' \
        > /etc/apt/apt.conf.d/99-timeout \
    && sed -i -e 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
              -e 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
        $(ls /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null) \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libopencv-core406 libopencv-imgcodecs406 libopencv-imgproc406 libopencv-videoio406 \
        libsqlite3-0 libssl3 libgomp1 libmpfr6 ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,from=cuda-toolkit,source=/,target=/usr/local/cuda-toolkit \
    cp -a /usr/local/cuda-toolkit/targets/x86_64-linux/lib/libcudart.so.13* /usr/local/lib/ \
    && ldconfig
ENV FSD_ENABLE_LEGACY_API=0 \
    FSD_ENABLE_LEGACY_FORMULA_COMPILER=0 \
    FSD_STARTUP_BENCHMARK=quick
WORKDIR /workspace/fractal_studio
COPY --from=build /src/build/fractal_studio_backend /usr/local/bin/fractal_studio_backend
COPY frontend/package.json /workspace/fractal_studio/frontend/package.json
COPY backend/CMakeLists.txt /workspace/fractal_studio/backend/CMakeLists.txt
RUN groupadd --system fractal \
    && useradd --system --gid fractal --home-dir /workspace/fractal_studio fractal \
    && mkdir -p /workspace/fractal_studio/runtime \
    && chown -R fractal:fractal /workspace/fractal_studio
USER fractal
EXPOSE 18080
CMD ["fractal_studio_backend", "18080"]
