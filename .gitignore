# Build outputs
/backend/build/
/backend/build_*/
/build/
/cmake-build-*/
/backend/CMakeFiles/
/backend/CMakeCache.txt
/backend/cmake_install.cmake
/backend/Makefile
*.o
*.o.d
*.a
*.so
*.dylib
*.dll
*.exe

# Runtime outputs
/runtime/
/fractal_studio.db
*.sqlite
*.sqlite3
*.db

# Local Codex/agent state
/.codex
/.codex/
/.claude/


# Frontend deps/build
/frontend/node_modules/
# This worktree links node_modules to the fractal_studio worktree; git treats
# the symlink as a file, so also ignore the bare path.
/frontend/node_modules
/frontend/dist/
/frontend/*.tsbuildinfo
# frontend/.gitignore already covers /frontend/.next; this catches a stray
# build run from the repo root, which leaves trace files here instead.
/.next/

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local docs
HS_legacy_guide_zh.md

# Generated reports
CODE_REVIEW_REPORT.md
PERFORMANCE_OPTIMIZATION_REPORT.md
EXPLORATION_REPORT.md
.build.log

# Local safety backups
*.bak
*.bak.*
*.old

# Local credentials and browser-test artifacts
.env
.env.*
!.env.example
!frontend/.env.example
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.dump
*.tar.gz
.DS_Store
auth.json
/ai.env
frontend/test-results/
frontend/playwright-report/
