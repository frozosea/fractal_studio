# Root Docker dev stand. These values are development-only.
FSD_COMPUTE_SERVICE_KEY=dev-compute-key-change-me
COMPUTE_GATEWAY_SERVICE_KEY=dev-gateway-key-change-me
COMPUTE_GATEWAY_ADMIN_KEY=dev-gateway-admin-key-change-me
COMPUTE_GATEWAY_DB_PASSWORD=gateway_dev_password
COMPUTE_GATEWAY_POSTGRES_PORT=25443
COMPUTE_GATEWAY_PORT=18103
COMPUTE_B_PORT=18104
# Public origins used when this development stack sits behind an HTTPS reverse proxy.
# FSD_API_ORIGIN=https://ai.example.com
# FSD_S3_PUBLIC_ENDPOINT_URL=https://ai.example.com
FRONTEND_PORT=3010
PLATFORM_PORT=18100
COMPUTE_PORT=18101
POSTGRES_PORT=15442
REDIS_PORT=16389
MINIO_PORT=19010
MINIO_CONSOLE_PORT=19011
ALIPAY_STUB_PORT=18102
