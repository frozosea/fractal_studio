# Compatibility example for the currently deployed Node 1. New Compute hosts
# should start from wg0.compute.example and choose a unique WireGuard address.
[Interface]
Address = 10.66.0.2/24
PrivateKey = REPLACE_NODE1_PRIVATE_KEY

[Peer]
PublicKey = REPLACE_VPS_PUBLIC_KEY
Endpoint = REPLACE_VPS_PUBLIC_IP:51820
AllowedIPs = 10.66.0.1/32
PersistentKeepalive = 25
