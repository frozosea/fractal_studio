# Copy to /etc/fractal-prod/vps.env, replace every REPLACE_* value, then set
# owner root:root and mode 0600. Never commit the populated file.

# Immutable application images. Build elsewhere and load them onto the VPS.
FRONTEND_IMAGE=fractal-frontend:REPLACE_GIT_SHA
PLATFORM_IMAGE=fractal-platform:REPLACE_GIT_SHA
GATEWAY_IMAGE=fractal-compute-gateway:REPLACE_GIT_SHA

# PostgreSQL and session secrets.
PLATFORM_DB_PASSWORD=REPLACE_RANDOM_PLATFORM_DB_PASSWORD
GATEWAY_DB_PASSWORD=REPLACE_RANDOM_GATEWAY_DB_PASSWORD
SESSION_SECRET=REPLACE_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS

# Gateway trust boundaries. COMPUTE_UPSTREAM_SERVICE_KEY must equal
# FSD_COMPUTE_SERVICE_KEY on every Compute node until per-node keys exist.
COMPUTE_GATEWAY_SERVICE_KEY=REPLACE_RANDOM_PLATFORM_TO_GATEWAY_KEY
COMPUTE_GATEWAY_ADMIN_KEY=REPLACE_RANDOM_GATEWAY_ADMIN_KEY
COMPUTE_UPSTREAM_SERVICE_KEY=REPLACE_RANDOM_GATEWAY_TO_COMPUTE_KEY

# Complete declarative node inventory as a single-line JSON array. [] is a
# valid zero-node control-plane configuration. See INSTALL.md before enabling
# nodes; repeat one object per node and keep nodeKey stable for its lifetime.
COMPUTE_GATEWAY_BOOTSTRAP_NODES_JSON=[]

# MinIO. Generate MINIO_KMS_SECRET_KEY once and include it in encrypted backup.
MINIO_ROOT_USER=fractal-prod
MINIO_ROOT_PASSWORD=REPLACE_RANDOM_MINIO_PASSWORD
MINIO_KMS_SECRET_KEY=fractal-prod:REPLACE_BASE64_32_BYTE_MASTER_KEY

# Alipay production configuration. PEM files are mounted separately from
# /etc/fractal-prod/secrets and must be mode 0600.
ALIPAY_APP_ID=REPLACE_ALIPAY_APP_ID
ALIPAY_SELLER_ID=REPLACE_ALIPAY_SELLER_ID
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# Studio AI is optional and fails closed. AI_PROVIDER selects the active
# provider ("siliconflow" or "deepseek"); the matching key must be set when
# AI_ENABLED=true because the API refuses to boot without it.
AI_ENABLED=false
AI_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.6-35B-A3B
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_FREE_LIFETIME_LIMIT=10
AI_HISTORY_TTL_DAYS=90
AI_MAX_USER_MESSAGE_CHARS=4000
AI_MAX_OUTPUT_TOKENS=2400
AI_MAX_IMAGE_BYTES=1048576
AI_MAX_CONCURRENT_PER_USER=2
