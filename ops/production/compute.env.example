# Install one independent copy on each Compute host. Change every REPLACE_*
# value, set owner root:root and mode 0600, and never commit the populated file.

# Stable, globally unique deployment identity. Examples: fractal-compute-a-prod,
# fractal-compute-render-west-prod. Do not reuse a project name on one host.
COMPOSE_PROJECT_NAME=fractal-compute-example-prod

# Immutable image built for this node's CUDA architecture.
COMPUTE_IMAGE=fractal-compute:replace-git-sha-sm89
FSD_RENDERER_VERSION=replace-git-sha-sm89

# Must match COMPUTE_UPSTREAM_SERVICE_KEY on the VPS.
FSD_COMPUTE_SERVICE_KEY=REPLACE_RANDOM_GATEWAY_TO_COMPUTE_KEY

# Unique WireGuard address and host-local runtime path for this node.
COMPUTE_BIND_IP=10.66.0.254
COMPUTE_RUNTIME_PATH=/srv/fractal-compute-example-prod/runtime

# Tune only after a benchmark; Gateway slot limits are configured separately.
FSD_STARTUP_BENCHMARK=quick
FSD_RENDER_THREADS=2
FSD_THERMAL_FRIENDLY=0
