# Pinned to the same base the dev image uses (see Dockerfile for why Node 24
# and why a patch pin): a floating node:22-bookworm-slim already drifted once
# underneath this image. Production `next start` is unaffected by the Node 22
# eval restriction documented in the dev Dockerfile.
FROM node:24.18.0-bookworm-slim

WORKDIR /app
RUN npm install --global pnpm@11.17.0 --registry=https://registry.npmmirror.com

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_PLATFORM_API_URL=/platform \
    PLATFORM_INTERNAL_URL=http://api:8000

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --registry=https://registry.npmmirror.com

COPY frontend/ ./
RUN pnpm build

EXPOSE 3000
CMD ["pnpm", "start", "--hostname", "0.0.0.0", "--port", "3000"]
